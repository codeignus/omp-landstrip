{
  "name": "omp-landstrip",
  "version": "0.1.0",
  "description": "Sandboxed bash tool for omp (Oh My Pi)",
  "keywords": [
    "landstrip",
    "omp-extension",
    "omp-package",
    "sandbox"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codeignus/omp-landstrip.git"
  },
  "files": [
    "dist/",
    "README.md",
    "sandbox.json"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.ts"
  },
  "scripts": {
    "build": "node -e \"const fs = require('node:fs'); fs.rmSync('dist', { recursive: true, force: true }); fs.mkdirSync('dist'); fs.copyFileSync('sandbox.json', 'dist/sandbox.json')\" && bun build index.ts --outfile dist/index.ts --target=node --packages=external",
    "prepack": "npm run build",
    "fmt": "oxfmt *.ts package.json tsconfig.json sandbox.json .oxfmtrc.json README.md",
    "lint": "oxlint .",
    "check": "tsc --noEmit",
    "test": "npm run build && vitest run",
    "all": "npm run fmt && npm run lint && npm run check && npm run test",
    "ci:fmt": "oxfmt --check *.ts package.json tsconfig.json sandbox.json .oxfmtrc.json README.md",
    "ci:lint": "npm run lint",
    "ci:check": "npm run check",
    "ci:test": "npm run test"
  },
  "dependencies": {
    "@landstrip/landstrip-api": "^0.19.7"
  },
  "devDependencies": {
    "@oh-my-pi/pi-coding-agent": "18.1.5",
    "@types/node": "^26.4.1",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.68.0",
    "typebox": "^1.3.6",
    "typescript": "^5.0.0",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "@oh-my-pi/pi-coding-agent": "*",
    "typebox": "*"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "omp": {
    "extensions": [
      "./dist/index.ts"
    ]
  }
}
